<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3A3232"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2C2828"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:id="@+id/linearLayout4"
            android:layout_width="380dp"
            android:layout_height="81dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtCalculator"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:text="@string/txtCalculator"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/dimenTxtCalculator" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="109dp"
            android:layout_height="472dp"
            android:layout_marginTop="81dp"
            android:layout_marginBottom="2dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/linearLayout2"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout4">

            <Button
                android:id="@+id/btnPlus"
                android:layout_width="match_parent"
                android:layout_height="114dp"
                android:onClick="addition"
                android:text="@string/txtPlus"
                android:textColorLink="#673AB7"
                android:textSize="@dimen/dimenBtnOperation" />

            <Button
                android:id="@+id/btnMin"
                android:layout_width="match_parent"
                android:layout_height="114dp"
                android:onClick="subtraction"
                android:text="@string/txtMin"
                android:textSize="@dimen/dimenBtnOperation" />

            <Button
                android:id="@+id/btnDiv"
                android:layout_width="match_parent"
                android:layout_height="114dp"
                android:onClick="division"
                android:text="@string/txtDiv"
                android:textSize="@dimen/dimenBtnOperation" />

            <Button
                android:id="@+id/btnMol"
                android:layout_width="match_parent"
                android:layout_height="114dp"
                android:onClick="multiplication"
                android:text="@string/txtMol"
                android:textSize="@dimen/dimenBtnOperation" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="267dp"
            android:layout_height="493dp"
            android:layout_marginTop="53dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/linearLayout4">

            <EditText
                android:id="@+id/txtNum1"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:ems="10"
                android:hint="@string/hintInsNum1"
                android:inputType="numberDecimal"
                android:text=""
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF" />


            <EditText
                android:id="@+id/txtNum2"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:ems="10"
                android:hint="@string/hintInsNum2"
                android:inputType="numberDecimal"
                android:text=""
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF" />

            <TextView
                android:id="@+id/txtRisultato"
                android:layout_width="match_parent"
                android:layout_height="73dp"
                android:text="@string/txtRisultato"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/dimenTxtRisultato" />


        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>